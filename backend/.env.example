# Copy to .env (gitignored) and fill in real values. Never commit .env.
#
# This must be the actual Postgres connection string -- NOT the
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY pair from
# the Supabase JS client SDK. Those go through Supabase's REST gateway
# (PostgREST); this backend talks raw Postgres wire protocol via pgx and
# needs the database password, which the publishable/anon key does not carry.
#
# Find it in the Supabase dashboard: Project Settings -> Database ->
# Connection string -> URI. Use the *direct* connection (port 5432), not the
# transaction-mode pooler (port 6543) -- golang-migrate and pgx's prepared
# statements don't play well with pgbouncer's transaction pooling.
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

PORT=8080

# Used to fetch this project's JWKS to verify Supabase Auth JWTs -- just the
# project's HTTPS URL (the same value as EXPO_PUBLIC_SUPABASE_URL client-side),
# no secret key needed.
SUPABASE_URL=https://[PROJECT-REF].supabase.co

APIFY_TOKEN=
SUPPLIER_SYNC_LOCATIONS=Gangtok, Sikkim, India
SUPPLIER_SYNC_SEARCH_TERMS=restaurant
SUPPLIER_SYNC_MAX_RESULTS=100
